# Mac Mini 本机 Nginx 配置模板。
# scripts/deploy-macmini.sh 会替换占位符后写到远端 .run/nginx/nginx.conf。
# Docker 部署仍使用 deploy/nginx.conf（反代主机名是 compose 里的 api）。

worker_processes 1;
daemon on;
error_log "__PREFIX__/logs/error.log";
pid "__PREFIX__/logs/nginx.pid";

events {
    worker_connections 512;
}

http {
    include "__MIME__";
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
    charset utf-8;

    client_body_temp_path "__PREFIX__/tmp/client_body";
    proxy_temp_path       "__PREFIX__/tmp/proxy";
    fastcgi_temp_path     "__PREFIX__/tmp/fastcgi";
    uwsgi_temp_path       "__PREFIX__/tmp/uwsgi";
    scgi_temp_path        "__PREFIX__/tmp/scgi";

    access_log "__PREFIX__/logs/access.log";

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain
                      text/css
                      text/xml
                      text/javascript
                      application/javascript
                      application/json
                      application/xml
                      application/manifest+json
                      image/svg+xml
                      font/woff
                      font/woff2;

    server {
        listen __BIND__:__PORT__;
        server_name _;

        root "__ROOT__";
        index index.html;

        client_max_body_size 16m;

        location /assets/ {
            access_log off;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass         http://127.0.0.1:__API_PORT__;
            proxy_http_version 1.1;
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   X-Forwarded-Host  $http_host;
            proxy_connect_timeout 10s;
            proxy_send_timeout    300s;
            proxy_read_timeout    300s;
            proxy_buffering off;
        }

        location /ws/ {
            proxy_pass         http://127.0.0.1:__API_PORT__;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection "upgrade";
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   X-Forwarded-Host  $http_host;
            proxy_connect_timeout 10s;
            proxy_send_timeout    3600s;
            proxy_read_timeout    3600s;
            proxy_buffering       off;
        }
    }

    # 只监听回环地址，供本机 /api/status 读取连接数，不对局域网开放。
    server {
        listen 127.0.0.1:8157;
        server_name _;
        access_log off;

        location = /nginx_status {
            stub_status;
            allow 127.0.0.1;
            allow ::1;
            deny all;
        }

        location / {
            return 404;
        }
    }
}
