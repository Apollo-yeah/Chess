{
  "name": "z-chess",
  "version": "2.0.0",
  "description": "Chess AI application — unified React + Tornado monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "npm run build && cross-env PYTHONPATH=. python -m app",
    "start:server": "cross-env PYTHONPATH=. python -m app",
    "install:all": "npm install && pip install -r requirements.txt"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "chess.js": "^1.4.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "python": ">=3.8"
  },
  "keywords": [
    "chess",
    "react",
    "tornado",
    "stockfish",
    "vite"
  ],
  "license": "MIT"
}
